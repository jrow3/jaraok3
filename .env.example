# Copy to .env next to docker-compose.yml and edit. Docker Compose reads it at
# `docker compose up -d`; `npm run dev` reads it too. Only KARAOKE_LIBRARY is required.

# --- The basics ---------------------------------------------------------------------

# Your karaoke library on the host: mp3+cdg pairs and/or mp4 videos, named
# "Artist - Title [Brand]". Mounted read-only into the container.
KARAOKE_LIBRARY=/path/to/your/karaoke/library
# Gates the host page (/admin). Empty leaves it open: fine only on a network you trust.
ADMIN_PIN=
# Lets the TV act as the TV: open it at /display?t=<this>. Empty: any phone can claim to
# be the TV and skip or fail songs. Signing in with the PIN on the TV works too.
DISPLAY_TOKEN=
# The host port the app answers on.
KARAOKE_PORT=3000
# The address guests open, shown on the TV with a QR code. Empty: the TV shows the
# address it was opened at. Set it when the TV loads from another address than guests
# use (a kiosk on localhost, or a public URL for guests).
JOIN_URL=
# The app's name in titles and the wordmark. Empty: jaraok3.
PUBLIC_APP_NAME=

# Which release to run: `latest`, or pin one such as 1.0.0 (see the GitHub releases).
JARAOK3_VERSION=latest

# --- Library ---------------------------------------------------------------------------

# on: scan every subfolder. off: only the top folder and downloads/, for a big library on
# a slow exFAT USB drive, where a full walk makes rescans crawl.
LIBRARY_RECURSIVE=on

# --- YouTube ---------------------------------------------------------------------------

# Search YouTube when the library doesn't have a song (keyless, via yt-dlp in the image).
YOUTUBE=on
# Download a picked video that YouTube won't let the TV embed, then play it locally.
DOWNLOADS=on
# Where those downloads go on the host: a downloads/ folder inside your library, so the
# index finds them. Empty: ./downloads next to docker-compose.yml.
KARAOKE_DOWNLOADS=
# Optional Last.fm API key (free at last.fm/api) for "Suggested for you". Without it,
# suggestions use the library and play history only.
LASTFM_API_KEY=

# --- Hardware (both optional; off unless you've set them up) -----------------------------

# The Sound tab and guests' "Your sound": live voice effects through PipeWire on this
# machine. Set up deploy/audio/ first (README there).
MIXER=off
# Mic inputs into the mixer: 2 (one mic per line-in channel) or 1. Same as MIC_INPUTS in
# deploy/audio/audio.env.
MIC_INPUTS=2
# The host page's System button, which turns a TV kiosk run by this machine on and off.
# Set up deploy/kiosk/ first (README there).
KIOSK=off

# --- Local dev only (`npm run dev`; Docker sets these itself) ----------------------------

LIBRARY_PATH=/path/to/your/karaoke/library
DB_PATH=data/index.db
# A yt-dlp binary for YouTube search in dev (the container ships its own), e.g. the
# standalone release saved to ./bin.
YT_DLP=yt-dlp
# Where the TV flag and mixer files are written in dev.
CONTROL_DIR=./control
# Where downloads land (inside LIBRARY_PATH, so the index finds them) and are merged first.
DOWNLOADS_DIR=/path/to/your/karaoke/library/downloads
TEMP_DIR=data/tmp
# Optional: a signed-in cookies.txt for yt-dlp, if YouTube asks it to sign in.
YT_COOKIES=
