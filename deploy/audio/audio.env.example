# Your audio interface, for the mic chain (render_conf.py) and the mixer agent.
# Copy to deploy/audio/audio.env (gitignored) and fill in your own values.
# Find the node names with:  pw-cli ls Node | grep -E 'node.name = "alsa_(input|output)'

# Where the mics come in. This example is a Creative Sound Blaster X-Fi Surround 5.1 USB,
# mics into its line in.
AUDIO_SOURCE=alsa_input.usb-Creative_Technology_SB_X-Fi_Surround_5.1-00.analog-stereo
# Where the room hears it (and the songs): the same interface's output, usually.
AUDIO_SINK=alsa_output.usb-Creative_Technology_SB_X-Fi_Surround_5.1-00.analog-stereo

# 2: two mics on a stereo line in, one per channel, each with its own trim.
# 1: one mic, or anything else; the input is summed to mono.
# Set the same MIC_INPUTS in the app's .env, so the Sound tab shows the matching faders.
MIC_INPUTS=2

# Where the LADSPA plugins live (swh-plugins). Debian/Ubuntu: /usr/lib/ladspa;
# Fedora/openSUSE: /usr/lib64/ladspa.
LADSPA_DIR=/usr/lib/ladspa

# Buffer for the mic chain. Lower = less delay between singing and hearing it, but more
# risk of dropouts. 512/48000 is about 11 ms.
AUDIO_LATENCY=512/48000
