[Unit]
Description=Karaoke TV kiosk (Chromium via cage)
# Runs on the physical console; take over tty1 from the login prompt.
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
# The user that owns the graphical session. If you use the mixer (deploy/audio), make
# this the same user PipeWire and the mixer agent run as, or the TV's sound goes to a
# different PipeWire than the mics.
User=karaoke
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# The app's host port: KARAOKE_PORT in the app's .env (3000 unless you changed it).
Environment=KARAOKE_PORT=3000
# DISPLAY_TOKEN from the app's .env. Letters and digits only: it goes into the URL as is.
Environment=DISPLAY_TOKEN=
# cage = single-app Wayland kiosk compositor. Chromium's binary is `chromium` on
# Debian; use `chromium-browser`, or /snap/bin/chromium on Ubuntu, if that's what your
# distro ships. The autoplay flag lets audio play with no click. Point at localhost:
# media never leaves the box.
ExecStart=/usr/bin/cage -- /usr/bin/chromium \
  --kiosk \
  --app=http://localhost:${KARAOKE_PORT}/display?t=${DISPLAY_TOKEN} \
  --autoplay-policy=no-user-gesture-required \
  --noerrdialogs --disable-infobars --disable-translate \
  --check-for-update-interval=31536000
Restart=on-failure

# Deliberately NO [Install] section: this is started/stopped on demand by
# karaoke-kiosk-watch, not enabled at boot. The box stays headless until then.
